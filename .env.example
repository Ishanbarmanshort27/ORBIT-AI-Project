# Public Firebase web config (these are not server secrets; secure data with Firestore Rules)
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me

# Public URL of your deployed Cloudflare Worker API
VITE_ORBIT_API_URL=https://your-worker.your-subdomain.workers.dev